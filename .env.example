DATABASE_URL="file:./dev.db"

AI_PROVIDER="mock"
AI_FALLBACK_PROVIDER="none"
AI_TIMEOUT_MS="20000"
AI_MAX_RETRIES="1"
AI_RETRY_DELAY_MS="500"

OPENAI_API_KEY="your_openai_key_here"
OPENAI_MODEL="gpt-4o-mini"
CRON_SECRET="replace_with_a_secure_random_secret"

MONITORING_RAW_RETENTION_DAYS="30"
MONITORING_AGGREGATE_RETENTION_DAYS="730"
MONITORING_RETENTION_BATCH_SIZE="500"
