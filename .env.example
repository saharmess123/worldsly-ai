DATABASE_URL="postgresql://username:password@ep-some-pooler-id.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-some-direct-id.us-east-2.aws.neon.tech/neondb?sslmode=require"
AI_PROVIDER="mock"
AI_FALLBACK_PROVIDER="none"
