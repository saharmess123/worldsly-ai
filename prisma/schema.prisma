generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  plan         String   @default("free")
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings        UserSettings?
  optimizations   Optimization[]
  feedback        Feedback[]
  apiKeys         ApiKey[]
  curationReviews CurationReview[]
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  preferredModel    String   @default("GPT-4.1 / GPT-5 style")
  optimizationDepth String   @default("Balanced")
  defaultGoal       String   @default("More structured")
  outputFormat      String   @default("Detailed explanation")
  personalStyle     String?
  discoveryFocus    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Optimization {
  id             String   @id @default(cuid())
  userId         String?
  originalPrompt String
  improvedPrompt String
  category       String   @default("General")
  model          String   @default("GPT-4.1 / GPT-5 style")
  goal           String   @default("More structured")
  depth          String   @default("Balanced")
  outputFormat   String   @default("Detailed explanation")
  originalScore  Int      @default(0)
  improvedScore  Int      @default(0)
  engineStatus   String   @default("mock_api")
  createdAt      DateTime @default(now())

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  feedback Feedback[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model Feedback {
  id             String   @id @default(cuid())
  userId         String?
  optimizationId String?
  rating         String
  comment        String?
  originalPrompt String
  improvedPrompt String
  category       String   @default("General")
  model          String   @default("GPT-4.1 / GPT-5 style")
  goal           String   @default("More structured")
  depth          String   @default("Balanced")
  outputFormat   String   @default("Detailed explanation")
  engineStatus   String   @default("mock_api")
  createdAt      DateTime @default(now())

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  optimization      Optimization?      @relation(fields: [optimizationId], references: [id], onDelete: SetNull)
  evaluationResults EvaluationResult[]

  @@index([userId])
  @@index([optimizationId])
  @@index([rating])
  @@index([createdAt])
}

model Source {
  id                    String    @id @default(cuid())
  name                  String
  type                  String
  url                   String?
  credibilityScore      Int       @default(0)
  credibilityMethod     String    @default("manual")
  credibilityConfidence Int       @default(0)
  credibilityReason     String?
  credibilityUpdatedAt  DateTime?
  status                String    @default("active")
  lastScanAt            DateTime?
  scanFrequency         String    @default("manual")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  discoveredPrompts DiscoveredPrompt[]
  scanEvents        SourceScanEvent[]
  credibilityAlerts SourceCredibilityAlert[]

  @@index([type])
  @@index([status])
}

model SourceScanEvent {
  id                      String    @id @default(cuid())
  sourceId                String
  trigger                 String    @default("manual")
  status                  String
  provider                String?
  createdCount            Int       @default(0)
  generatedCount          Int       @default(0)
  skippedDuplicateCount   Int       @default(0)
  retrievedCharacterCount Int       @default(0)
  durationMs              Int       @default(0)
  errorCode               String?
  errorMessage            String?
  credibilityScore        Int?
  credibilityConfidence   Int?
  credibilityReason       String?
  startedAt               DateTime  @default(now())
  completedAt             DateTime?

  source            Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  credibilityAlerts SourceCredibilityAlert[]

  @@index([sourceId])
  @@index([trigger])
  @@index([status])
  @@index([startedAt])
}

model SourceCredibilityAlert {
  id            String    @id @default(cuid())
  sourceId      String
  scanEventId   String?
  severity      String
  status        String    @default("open")
  alertType     String
  currentScore  Int
  previousScore Int?
  scoreDrop     Int?
  threshold     Int?
  message       String
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  source    Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scanEvent SourceScanEvent? @relation(fields: [scanEventId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([scanEventId])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model DiscoveredPrompt {
  id           String   @id @default(cuid())
  sourceId     String?
  title        String
  prompt       String
  category     String   @default("General")
  model        String   @default("General")
  qualityScore Int      @default(0)
  sourceUrl    String?
  status       String   @default("pending")
  discoveredAt DateTime @default(now())

  source          Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  curationReviews CurationReview[]
  corpusPrompt    CorpusPrompt?

  @@index([sourceId])
  @@index([category])
  @@index([status])
  @@index([discoveredAt])
}

model CurationReview {
  id                 String   @id @default(cuid())
  discoveredPromptId String
  reviewerId         String?
  status             String
  riskLevel          String   @default("low")
  reviewReason       String?
  createdAt          DateTime @default(now())

  discoveredPrompt DiscoveredPrompt @relation(fields: [discoveredPromptId], references: [id], onDelete: Cascade)
  reviewer         User?            @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([discoveredPromptId])
  @@index([reviewerId])
  @@index([status])
}

model CorpusPrompt {
  id                 String   @id @default(cuid())
  discoveredPromptId String?  @unique
  title              String
  prompt             String
  improvedVersion    String?
  category           String   @default("General")
  model              String   @default("General")
  qualityScore       Int      @default(0)
  patterns           String?
  metadata           String?
  isArchived         Boolean  @default(false)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  discoveredPrompt  DiscoveredPrompt?  @relation(fields: [discoveredPromptId], references: [id], onDelete: SetNull)
  trainingSignals   TrainingSignal[]
  evaluationResults EvaluationResult[]

  @@index([category])
  @@index([model])
  @@index([qualityScore])
  @@index([isArchived])
}

model TrainingSignal {
  id               String   @id @default(cuid())
  deduplicationKey String?  @unique
  sourceType       String
  sourceId         String?
  corpusId         String?
  signalType       String
  score            Int      @default(0)
  metadata         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  corpus CorpusPrompt? @relation(fields: [corpusId], references: [id], onDelete: Cascade)

  @@index([sourceType])
  @@index([signalType])
  @@index([corpusId])
  @@index([sourceId])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String
  label      String?
  usageLimit Int       @default(1000)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIRuntimeEvent {
  id               String   @id @default(cuid())
  operation        String   @default("generate")
  primaryProvider  String
  resolvedProvider String
  fallbackProvider String?
  model            String
  success          Boolean
  usedFallback     Boolean  @default(false)
  attemptCount     Int      @default(1)
  latencyMs        Int
  error            String?
  createdAt        DateTime @default(now())

  @@index([operation])
  @@index([primaryProvider])
  @@index([resolvedProvider])
  @@index([success])
  @@index([createdAt])
}

model EvaluationRun {
  id                String             @id @default(cuid())
  meanAbsoluteError Float
  status            String
  testedCount       Int
  runType           String             @default("quality_calibration")
  provider          String?
  createdAt         DateTime           @default(now())
  results           EvaluationResult[]
}

model EvaluationResult {
  id                     String   @id @default(cuid())
  evaluationRunId        String
  corpusPromptId         String?
  feedbackId             String?
  promptTitle            String
  promptContent          String
  targetScore            Int
  calculatedScore        Int
  scoreDeviation         Int
  scoringMode            String
  clarityTarget          Int      @default(0)
  clarityCalculated      Int      @default(0)
  specificityTarget      Int      @default(0)
  specificityCalculated  Int      @default(0)
  contextTarget          Int      @default(0)
  contextCalculated      Int      @default(0)
  constraintsTarget      Int      @default(0)
  constraintsCalculated  Int      @default(0)
  outputFormatTarget     Int      @default(0)
  outputFormatCalculated Int      @default(0)
  createdAt              DateTime @default(now())

  evaluationRun EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  corpusPrompt  CorpusPrompt? @relation(fields: [corpusPromptId], references: [id], onDelete: SetNull)
  feedback      Feedback?     @relation(fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([evaluationRunId])
  @@index([corpusPromptId])
  @@index([feedbackId])
}

model ProviderBenchmarkRun {
  id              String                    @id @default(cuid())
  status          String                    @default("running")
  datasetVersion  String                    @default("v1")
  testedProviders Int
  testCaseCount   Int
  timeoutMs       Int
  maxRetries      Int
  fallbackEnabled Boolean                   @default(false)
  startedAt       DateTime                  @default(now())
  completedAt     DateTime?
  results         ProviderBenchmarkResult[]

  @@index([status])
  @@index([startedAt])
}

model ProviderBenchmarkResult {
  id               String   @id @default(cuid())
  benchmarkRunId   String
  testCaseId       String
  promptTitle      String
  category         String
  provider         String
  resolvedProvider String
  fallbackProvider String?
  model            String
  success          Boolean
  usedFallback     Boolean  @default(false)
  retryUsed        Boolean  @default(false)
  attemptCount     Int      @default(1)
  latencyMs        Int
  qualityScore     Int      @default(0)
  outputLength     Int      @default(0)
  outputExcerpt    String?
  error            String?
  errorType        String?
  estimatedCostUsd Float?
  createdAt        DateTime @default(now())

  benchmarkRun ProviderBenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  @@index([benchmarkRunId])
  @@index([provider])
  @@index([success])
  @@index([errorType])
  @@index([qualityScore])
  @@index([createdAt])
}

model AIRuntimeDailyAggregate {
  id               String   @id @default(cuid())
  bucketStart      DateTime
  operation        String
  resolvedProvider String
  model            String
  success          Boolean
  requestCount     Int      @default(0)
  successCount     Int      @default(0)
  failureCount     Int      @default(0)
  fallbackCount    Int      @default(0)
  errorCount       Int      @default(0)
  totalAttempts    Int      @default(0)
  totalLatencyMs   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([bucketStart, operation, resolvedProvider, model, success])
  @@index([bucketStart])
  @@index([resolvedProvider])
  @@index([operation])
}

model SourceScanDailyAggregate {
  id                      String   @id @default(cuid())
  bucketStart             DateTime
  sourceId                String
  sourceName              String
  trigger                 String
  status                  String
  provider                String
  scanCount               Int      @default(0)
  completedCount          Int      @default(0)
  failedCount             Int      @default(0)
  runningCount            Int      @default(0)
  createdPromptCount      Int      @default(0)
  generatedPromptCount    Int      @default(0)
  skippedDuplicateCount   Int      @default(0)
  retrievedCharacterCount Int      @default(0)
  totalDurationMs         Int      @default(0)
  credibilityScoreTotal   Int      @default(0)
  credibilityScoreCount   Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([bucketStart, sourceId, trigger, status, provider])
  @@index([bucketStart])
  @@index([sourceId])
  @@index([trigger])
  @@index([provider])
}
